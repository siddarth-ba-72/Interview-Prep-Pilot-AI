{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://preppilot-gateway-production.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://preppilot-gateway-production.up.railway.app/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://preppilot-gateway-production.up.railway.app/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
