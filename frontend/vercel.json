{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://prep-pilot-gateway-service.onrender.com/api/v1/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://prep-pilot-gateway-service.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://prep-pilot-gateway-service.onrender.com/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
